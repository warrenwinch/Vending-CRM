# Copy this file to .env.local and fill in the two values from Supabase:
# Project Settings > API Keys (or "Connect" at the top of the dashboard).
# Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: email alerts when a customer reports a fault (see src/lib/alerts.ts).
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL=you@example.com
# ALERT_FROM=Watwin CRM <alerts@watwinvending.com.au>
